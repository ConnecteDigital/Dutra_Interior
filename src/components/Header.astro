---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, whatsappUrl } from '../data/site';
import { servicos } from '../data/servicos';
import { cidadesPorRegiao, cidadePath } from '../data/locais';

const grupos = cidadesPorRegiao();
---

<div class="topbar">
  <div class="container topbar-inner">
    <span><Icon name="clock" size={16} /> Plantão 24h em todo o DDD 19 · chegada em até {site.arrivalMinutes} min</span>
    <a href={site.tel} class="topbar-phone"><Icon name="phone" size={16} /> {site.phoneDisplay}</a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name}, página inicial`}><Logo /></a>

    <nav class="nav-desktop" aria-label="Principal">
      <div class="nav-item"><a href="/servicos/limpa-fossa/">Limpa fossa</a></div>
      <div class="nav-item has-sub">
        <a href="/servicos/" aria-haspopup="true">Desentupimento <span class="caret" aria-hidden="true"></span></a>
        <div class="submenu submenu-servicos">
          <ul>
            {servicos.map((s) => (
              <li>
                <a href={`/servicos/${s.slug}/`}><Icon name={s.icon} size={18} /> {s.nome}</a>
              </li>
            ))}
          </ul>
          <a class="submenu-all" href="/servicos/">Todos os serviços <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="nav-item has-sub">
        <a href="/cidades-atendidas/" aria-haspopup="true">Cidades <span class="caret" aria-hidden="true"></span></a>
        <div class="submenu submenu-areas">
          <div class="submenu-zonas">
            {grupos.map((g) => (
              <div>
                <p class="submenu-zona">{g.regiao.nome}</p>
                <ul>
                  {g.cidades.map((c) => (
                    <li><a href={cidadePath(c)}>{c.nome}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <a class="submenu-all" href="/cidades-atendidas/">Todas as cidades <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="nav-item"><a href="/blog/">Guia</a></div>
    </nav>

    <div class="header-cta">
      <a class="btn btn-call btn-sm header-phone" href={site.tel}><Icon name="phone" size={18} /> <span>{site.phoneDisplay}</span></a>
      <a class="btn btn-wa btn-sm" href={whatsappUrl()} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} /> <span>WhatsApp</span>
      </a>
      <details class="nav-mobile">
        <summary aria-label="Abrir menu"><span></span><span></span><span></span></summary>
        <nav aria-label="Menu">
          <a href="/servicos/limpa-fossa/"><Icon name="truck" size={18} /> Limpa fossa</a>
          <details class="mobile-sub">
            <summary>Serviços</summary>
            <ul>
              {servicos.map((s) => (
                <li><a href={`/servicos/${s.slug}/`}><Icon name={s.icon} size={18} /> {s.nome}</a></li>
              ))}
              <li><a href="/servicos/"><strong>Todos os serviços</strong></a></li>
            </ul>
          </details>
          <details class="mobile-sub">
            <summary>Cidades atendidas</summary>
            <ul>
              {grupos.map((g) => (
                <>
                  <li class="mobile-zona">{g.regiao.nome}</li>
                  {g.cidades.map((c) => (
                    <li><a href={cidadePath(c)}><Icon name="pin" size={16} /> {c.nome}</a></li>
                  ))}
                </>
              ))}
              <li><a href="/cidades-atendidas/"><strong>Todas as cidades</strong></a></li>
            </ul>
          </details>
          <a href="/blog/">Guia</a>
          <a href={site.tel}><Icon name="phone" size={18} /> Ligar: {site.phoneDisplay}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Fecha o menu do celular ao tocar fora dele ou ao escolher um link.
  const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
  }
</script>
