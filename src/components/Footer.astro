---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, whatsappUrl } from '../data/site';
import { servicos } from '../data/servicos';
import { cidades, cidadePath, fossaPath } from '../data/locais';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <Logo size={120} />
      <p>Desentupidora e limpa fossa 24 horas em Campinas e em toda a região do DDD 19, com chegada em até {site.arrivalMinutes} minutos.</p>
    </div>
    <ul class="footer-contact">
      <li><a href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Chamar no WhatsApp</a></li>
      <li><a href={site.tel}><Icon name="phone" size={20} /> {site.phoneDisplay}</a></li>
      <li><Icon name="clock" size={20} /> Aberto 24 horas, todos os dias</li>
    </ul>
  </div>
  <div class="container footer-grid">
    <div>
      <h2 class="footer-title">Serviços</h2>
      <ul class="footer-links">
        {servicos.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Desentupidora por cidade</h2>
      <ul class="footer-links footer-links-2col">
        {cidades.map((c) => <li><a href={cidadePath(c)}>{c.nome}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Limpa fossa por cidade</h2>
      <ul class="footer-links footer-links-2col">
        {cidades.map((c) => <li><a href={fossaPath(c)}>{c.nome}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {site.name}. Todos os direitos reservados.</p>
    <p>
      <a href="/cidades-atendidas/">Cidades atendidas</a> · <a href="/blog/">Guia</a> ·
      <a href="/politica-de-privacidade/">Política de privacidade</a>
    </p>
  </div>
</footer>
